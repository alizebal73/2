{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Database": {
    "FileName": "App_Data/gamenet.db"
  },
  "App": {
    "ProductVersion": "0.7.0",
